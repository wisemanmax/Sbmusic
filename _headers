# Response headers for hosts that support a static `_headers` file
# (Netlify, Cloudflare Pages). GitHub Pages IGNORES this file — if production is
# bare GitHub Pages these headers are NOT active; front it with Cloudflare or move
# to Netlify/Cloudflare Pages/Vercel (see SECURITY.md). Keep the CSP below in sync
# with vercel.json and SECURITY.md.
#
# script-src includes https://www.youtube.com for the background-radio IFrame API;
# frame-src allows the YouTube + Spotify players. 'unsafe-inline' is still required
# until admin.html's inline app is externalized (tracked as code-quality work).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.youtube.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; media-src 'self' blob:; connect-src 'self' https://rccwnyghfiinpoexvtwp.supabase.co; frame-src https://open.spotify.com https://www.youtube.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

# The catalog streams inline only — served so the browser plays it rather than offering a
# "Save As" download, and kept out of search indexes. (Audio that plays in a browser can
# still be captured by a determined user; this just stops casual downloads.)
/assets/man-of-my-word.mp3
  Content-Disposition: inline
  X-Robots-Tag: noindex, nofollow
  Cache-Control: public, max-age=31536000, immutable
